<!-- sale_approval_cost/security/sale_approval_security.xml -->
<odoo>
    <!-- Sales Person: tạo báo giá, không được duyệt -->
    <record id="group_sale_person" model="res.groups">
        <field name="name">Sales Person (Approval)</field>
        <field name="category_id" ref="base.module_category_sales_management"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <!-- Sales Team Leader -->
    <record id="group_sale_team_leader" model="res.groups">
        <field name="name">Sales Team Leader</field>
        <field name="category_id" ref="base.module_category_sales_management"/>
        <field name="implied_ids" eval="[(4, ref('sale_approval_cost.group_sale_person'))]"/>
    </record>

    <!-- Sales Manager -->
    <record id="group_sale_manager" model="res.groups">
        <field name="name">Sales Manager (Approval)</field>
        <field name="category_id" ref="base.module_category_sales_management"/>
        <field name="implied_ids" eval="[
            (4, ref('sale_approval_cost.group_sale_team_leader')),
            (4, ref('sales_team.group_sale_manager'))
        ]"/>
    </record>

    <!-- Finance Manager -->
    <record id="group_finance_manager" model="res.groups">
        <field name="name">Finance Manager (Sales Approval)</field>
        <field name="category_id" ref="base.module_category_accounting_and_finance"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_manager'))]"/>
    </record>
</odoo>
